      "id": "839553b1-fb2d-4fef-be0c-2274d41a605f",
      "name": "OpenAI Classifier",
      "notes": "PUBLIC TEMPLATE: Select your own OpenAI credential. The original credential and AI Gateway account metadata have been removed."
    },
    {
      "parameters": {
        "jsCode": "// Retrieve the original customer inquiry.\n\nconst inquiry = $(\"Normalize Inquiry\").first().json;\n\n// Retrieve the OpenAI response.\n\nconst response = $input.first().json;\n\n// The exact response structure can vary\n// depending on the OpenAI node configuration.\n\nlet classification =\n  response.output_text ??\n  response.output\n    ?.flatMap(item => item.content ?? [])\n    ?.find(item => item.type === \"output_text\")\n    ?.text ??\n  response.text ??\n  response.choices?.[0]?.message?.content ??\n  null;\n\n// Handle a response that is already parsed JSON.\n\nif (\n  !classification &&\n  response.summary &&\n  response.category\n) {\n  classification = response;\n}\n\n// Parse JSON if the response is a string.\n\nif (typeof classification === \"string\") {\n  try {\n    classification = JSON.parse(classification);\n  } catch (error) {\n    classification = null;\n  }\n}\n\n// Return the original inquiry together\n// with the classification results.\n\nif (\n  !classification ||\n  typeof classification !== \"object\" ||\n  Array.isArray(classification)\n) {\n  return [{\n    json: {\n      ...inquiry,\n      classification_error:\n        \"Could not extract valid JSON from OpenAI response\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...inquiry,\n\n    summary: classification.summary,\n    category: classification.category,\n    priority: classification.priority,\n    sentiment: classification.sentiment,\n\n    recommended_action:\n      classification.recommended_action,\n\n    needs_human_review:\n      classification.needs_human_review,\n\n    classifier_type: \"openai\"\n  }\n}];"
      },
