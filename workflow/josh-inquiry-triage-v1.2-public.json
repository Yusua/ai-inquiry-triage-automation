    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst requiredFields = [\n  \"summary\",\n  \"category\",\n  \"priority\",\n  \"sentiment\",\n  \"recommended_action\",\n  \"needs_human_review\"\n];\n\nconst allowedCategories = [\n  \"sales\",\n  \"support\",\n  \"billing\",\n  \"partnership\",\n  \"other\"\n];\n\nconst allowedPriorities = [\n  \"high\",\n  \"medium\",\n  \"low\"\n];\n\nconst allowedSentiments = [\n  \"positive\",\n  \"neutral\",\n  \"negative\"\n];\n\n// Find missing or empty fields\nconst missingFields = requiredFields.filter(field => {\n  const value = data[field];\n\n  return (\n    value === undefined ||\n    value === null ||\n    (typeof value === \"string\" && value.trim() === \"\")\n  );\n});\n\n// Check classification values\nconst invalidValues = [];\n\nif (!allowedCategories.includes(data.category)) {\n  invalidValues.push(\"category\");\n}\n\nif (!allowedPriorities.includes(data.priority)) {\n  invalidValues.push(\"priority\");\n}\n\nif (!allowedSentiments.includes(data.sentiment)) {\n  invalidValues.push(\"sentiment\");\n}\n\nif (typeof data.needs_human_review !== \"boolean\") {\n  invalidValues.push(\"needs_human_review\");\n}\n\n// Final validation\nconst valid =\n  missingFields.length === 0 &&\n  invalidValues.length === 0;\n\nreturn [{\n  json: {\n    ...data,\n    ai_validation: {\n      valid,\n      missing_fields: missingFields,\n      invalid_values: invalidValues\n    }\n  }\n}];"
      },
